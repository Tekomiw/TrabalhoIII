<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_exercicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <Button
        android:id="@+id/buttonAdicionarExercicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Adicionar Exercicio"/>

    <Button
        android:id="@+id/buttonVoltarExercicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"/>

    <TextView
        android:id="@+id/tvExerciciosList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lista de Exercicios"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/listViewExercicios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


</LinearLayout>