<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTreinoNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Treino"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#424242" />

        <TextView
            android:id="@+id/tvTreinoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objetivo do Treino"
            android:textSize="14sp"
            android:textColor="#666666" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonGerenciarExercicios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercícios"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2196F3"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        style="@style/Widget.Material3.Button" />

    <ImageButton
        android:id="@+id/buttonEditarTreino"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_edit_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#2196F3"
        android:layout_marginEnd="8dp" />

    <ImageButton
        android:id="@+id/buttonDeletarTreino"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_delete_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#F44336" />

</LinearLayout>