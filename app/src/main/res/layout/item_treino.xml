<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTreinoNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Treino"
            android:textSize="18sp"
            android:paddingEnd="8dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTreinoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objetivo do Treino"
            android:textSize="14sp"
            android:textColor="#666666"/>
    </LinearLayout>

    <Button
        android:id="@+id/buttonGerenciarExercicios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercícios"/>

    <ImageButton
        android:id="@+id/buttonEditarTreino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_edit_24"
        android:text="Editar"
        android:background="?attr/selectableItemBackground"/>

    <ImageButton
        android:id="@+id/buttonDeletarTreino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_delete_24"
        android:text="Deletar"
        android:background="?attr/selectableItemBackground"/>
</LinearLayout>